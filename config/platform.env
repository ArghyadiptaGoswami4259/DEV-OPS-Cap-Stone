# TaskFlow platform defaults for deterministic, self-configuring manifests.
# These are safe, non-secret local values. Override any key in the environment
# before running `make configure` for a real AWS account or DNS zone.

TASKFLOW_PROJECT=taskflow
TASKFLOW_AWS_REGION=ap-south-1
TASKFLOW_AWS_ACCOUNT_ID=111122223333
TASKFLOW_TF_STATE_PREFIX=taskflow-devops-tfstate
TASKFLOW_TF_LOCK_TABLE=taskflow-devops-tflocks
TASKFLOW_BACKUP_BUCKET=taskflow-devops-backups
TASKFLOW_BACKUP_ROLE=taskflow-backup
TASKFLOW_EXTERNAL_SECRETS_ROLE=taskflow-external-secrets
TASKFLOW_RDS_INSTANCE_IDENTIFIER=taskflow-primary
TASKFLOW_RDS_SECRET_NAME=taskflow/rds
TASKFLOW_PROD_HOST=taskflow.internal
TASKFLOW_STAGING_HOST=staging.taskflow.internal
TASKFLOW_CERT_EMAIL=platform-owner@taskflow.internal
TASKFLOW_TRACE_ID=0af7651916cd43dd8448eb211c80319c
