{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VeleroObjectStore",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET",
        "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/*"
      ]
    },
    {
      "Sid": "ManagedDatabaseSnapshots",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBSnapshot",
        "rds:DescribeDBSnapshots",
        "rds:DescribeDBInstances",
        "rds:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
